<%- include('partials/head', { title }) %>
<%- include('partials/header') %>

<section class="relative overflow-hidden border-b border-bedrock-700/60 bg-gradient-to-b from-bedrock-900 to-bedrock-950">
  <div class="absolute inset-0 opacity-20 bg-[radial-gradient(circle_at_20%_20%,#3fd66f66,transparent_40%),radial-gradient(circle_at_80%_70%,#3f7fd666,transparent_40%)]"></div>
  <div id="hero-particles" class="hero-particles"></div>

  <!-- floating pixel blocks -->
  <div class="absolute left-[6%] top-[22%] w-12 h-12 bg-gradient-to-br from-emerald-400 to-emerald-700 border border-emerald-300/40 rounded-md opacity-70 bob-wrap hidden md:block"></div>
  <div class="absolute right-[8%] top-[18%] w-8 h-8 bg-gradient-to-br from-yellow-300 to-amber-600 border border-yellow-200/40 rounded-md opacity-70 bob-wrap bw-2 hidden md:block"></div>
  <div class="absolute right-[22%] bottom-[18%] w-10 h-10 bg-gradient-to-br from-sky-400 to-blue-700 border border-sky-300/40 rounded-md opacity-70 bob-wrap bw-3 hidden md:block"></div>

  <div class="relative max-w-6xl mx-auto px-4 py-20 sm:py-28 text-center">
    <p class="anim-load inline-block px-3 py-1 rounded-full text-xs font-semibold tracking-wide bg-accent/10 text-accent border border-accent/30 mb-4">
      Survive · Build · Trade · Rank Up
    </p>
    <h1 class="anim-load ld-1 text-4xl sm:text-6xl font-extrabold text-white leading-tight">
      Welcome to <span class="text-accent"><%= shopName %></span>
    </h1>
    <p class="anim-load ld-2 mt-4 max-w-2xl mx-auto text-slate-300">
      Buy in-game coins, ranks and items as fast as a server restart. Pay with
      <span class="font-semibold text-pink-400">bKash</span> or other manual methods — we verify and
      <span class="text-accent font-semibold">the plugin delivers it in-game automatically</span>.
    </p>
    <div class="anim-load ld-3 mt-8 flex flex-wrap gap-3 justify-center">
      <a href="/shop" class="btn-shine px-6 py-3 rounded-lg bg-accent text-bedrock-950 font-bold hover:brightness-110 transition">Browse the Shop</a>
      <a href="/order/TRACK" class="px-6 py-3 rounded-lg border border-bedrock-600 text-slate-200 hover:bg-bedrock-800 transition">Track an Order</a>
    </div>
    <div class="anim-load ld-4 mt-10 inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-bedrock-800/70 border border-bedrock-700 text-sm">
      <span class="ping-dot w-2 h-2 rounded-full bg-accent"></span>
      Join now — IP: <code class="font-mono text-white"><%= mcIp %></code>
    </div>
  </div>
</section>

<section class="max-w-6xl mx-auto px-4 py-14">
  <h2 data-reveal class="text-2xl font-bold text-white mb-6">Featured deals</h2>
  <% if (featured.length === 0) { %>
    <p class="text-slate-400">Products are coming soon. Check back shortly!</p>
  <% } else { %>
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      <% featured.forEach(function(p, idx) { %>
        <form method="post" action="/cart/add" data-reveal data-delay="<%= idx %>" class="glow-card group bg-bedrock-850 border border-bedrock-700/60 rounded-xl p-5 flex flex-col">
          <div class="text-4xl mb-3 bob-wrap"><%= p.delivery_type === 'money' ? '🪙' : '🎁' %></div>
          <h3 class="font-bold text-white text-lg"><%= p.name %></h3>
          <p class="text-sm text-slate-400 mt-1 flex-1"><%= p.description %></p>
          <div class="mt-4 flex items-center justify-between">
            <span class="text-accent font-extrabold text-lg"><%= money(p.price_bdt) %></span>
            <div class="flex items-center gap-1">
              <input type="hidden" name="productId" value="<%= p.id %>" />
              <input type="number" name="qty" value="1" min="1" max="99" class="w-14 bg-bedrock-800 border border-bedrock-700 rounded-lg px-2 py-1.5 text-sm text-center" />
              <button class="btn-shine px-4 py-1.5 rounded-lg bg-accent text-bedrock-950 text-sm font-bold hover:brightness-110">Add</button>
            </div>
          </div>
        </form>
      <% }) %>
    </div>
  <% } %>
  <div data-reveal class="text-center mt-10">
    <a href="/shop" class="btn-shine inline-block px-6 py-3 rounded-lg border border-accent/50 text-accent font-semibold hover:bg-accent/10 transition">View all products →</a>
  </div>
</section>

<%- include('partials/footer') %>