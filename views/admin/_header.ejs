<div class="max-w-6xl mx-auto px-4 py-8">
  <div class="flex items-center justify-between mb-8">
    <h1 class="text-2xl font-extrabold text-white">Admin · <%= shopName %></h1>
    <div class="flex gap-2">
      <a href="/admin" class="px-3 py-2 rounded-lg text-sm border border-bedrock-700 text-slate-300 hover:bg-bedrock-800 <%- path === '/admin' ? 'bg-bedrock-800 text-white' : '' %>">Dashboard</a>
      <a href="/admin/orders" class="px-3 py-2 rounded-lg text-sm border border-bedrock-700 text-slate-300 hover:bg-bedrock-800 <%- path.startsWith('/admin/orders') ? 'bg-bedrock-800 text-white' : '' %>">Orders</a>
      <a href="/admin/products" class="px-3 py-2 rounded-lg text-sm border border-bedrock-700 text-slate-300 hover:bg-bedrock-800 <%- path.startsWith('/admin/products') ? 'bg-bedrock-800 text-white' : '' %>">Products</a>
      <form method="post" action="/admin/logout"><button class="px-3 py-2 rounded-lg text-sm border border-red-500/40 text-red-300 hover:bg-red-500/10">Logout</button></form>
    </div>
  </div>