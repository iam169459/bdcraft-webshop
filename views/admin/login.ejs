<%- include('../partials/head', { title }) %>
<div class="min-h-screen grid place-items-center px-4">
  <form method="post" action="/admin/login" class="w-full max-w-sm bg-bedrock-850 border border-bedrock-700/60 rounded-xl p-8 space-y-4">
    <div class="text-center">
      <span class="inline-grid w-12 h-12 rounded-xl bg-accent/10 border border-accent/30 place-items-center text-2xl mb-2">🔐</span>
      <h1 class="text-xl font-bold text-white">Admin login</h1>
      <p class="text-xs text-slate-500"><%= shopName %></p>
    </div>
    <% if (error) { %>
      <div class="text-red-400 text-sm bg-red-500/10 border border-red-500/30 rounded-lg px-3 py-2"><%= error %></div>
    <% } %>
    <input type="hidden" name="next" value="<%= typeof next !== 'undefined' ? (next || '/admin') : '/admin' %>" />
    <input name="user" required placeholder="Username" autocomplete="username"
           class="w-full bg-bedrock-900 border border-bedrock-700 rounded-lg px-4 py-3" />
    <input type="password" name="password" required placeholder="Password" autocomplete="current-password"
           class="w-full bg-bedrock-900 border border-bedrock-700 rounded-lg px-4 py-3" />
    <button class="w-full py-3 rounded-lg bg-accent text-bedrock-950 font-bold hover:brightness-110">Sign in</button>
    <a href="/" class="block text-center text-sm text-slate-500 hover:text-slate-300">← back to site</a>
  </form>
</div>
<%- include('../partials/footer') %>