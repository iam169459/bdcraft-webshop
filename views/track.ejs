<%- include('partials/head', { title }) %>
<%- include('partials/header') %>

<div class="max-w-2xl mx-auto px-4 py-10">
  <% if (!order) { %>
    <h1 class="text-3xl font-extrabold text-white mb-6">Track your order</h1>
    <p class="text-slate-400 mb-6">Enter your order code (like <code class="text-accent">BDC-ABC123</code>) to see its status.</p>
    <form method="get" action="/" onsubmit="event.preventDefault(); const c=this.o.value.trim(); if(c) location.href='/order/'+encodeURIComponent(c);"
          class="flex gap-2">
      <input name="o" placeholder="BDC-ABC123" required
             class="flex-1 bg-bedrock-900 border border-bedrock-700 rounded-lg px-4 py-3 font-mono uppercase" />
      <button class="px-6 py-3 rounded-lg bg-accent text-bedrock-950 font-bold">Track</button>
    </form>
  <% } else { %>
    <div class="bg-bedrock-850 border border-bedrock-700/60 rounded-xl p-6">
      <div class="flex items-start justify-between gap-4 mb-6">
        <div>
          <h1 class="text-2xl font-extrabold text-white">Order <span class="text-accent"><%= order.order_code %></span></h1>
          <p class="text-sm text-slate-400">
            <%= new Date(order.created_at).toLocaleString() %> · <%= order.payment_method === 'bkash' ? 'bKash' : 'Manual' %>
            <%= order.trx_id ? ' · ' + order.trx_id : '' %>
          </p>
        </div>
        <span class="px-3 py-1.5 rounded-full text-sm font-semibold <%= statusColor %>"><%= statusLabel %></span>
      </div>

      <% if (isPending) { %>
        <div class="border border-amber-500/30 bg-amber-500/10 rounded-lg p-4 text-sm text-amber-200 mb-6">
          <b>Waiting for payment verification.</b> Have you sent the money? If yes, we usually verify within
          15–30 minutes. Keep your <b>TrxID</b> handy in case we ask.
        </div>
      <% } %>

      <ul class="divide-y divide-bedrock-700/60">
        <% items.forEach(function(it) { %>
          <li class="py-3 flex items-center justify-between">
            <div>
              <p class="font-semibold text-white"><%= it.name %> <span class="text-slate-500">×<%= it.qty %></span></p>
              <% if (it.delivery_type === 'money' && it.amount) { %>
                <p class="text-xs text-slate-400"><%= Number(it.amount).toLocaleString() %> in-game coins</p>
              <% } %>
            </div>
            <div class="text-right">
              <p class="text-accent font-bold"><%= money(it.price * it.qty) %></p>
              <% if (it.delivered) { %>
                <span class="text-xs text-green-400">✓ delivered <%= it.delivered_at ? new Date(it.delivered_at).toLocaleString() : '' %></span>
              <% } else if (order.status === 'paid') { %>
                <span class="text-xs text-blue-300">queued for in-game delivery</span>
              <% } %>
            </div>
          </li>
        <% }) %>
      </ul>

      <div class="mt-6 flex items-center justify-between border-t border-bedrock-700/60 pt-4">
        <p class="font-bold text-white">Total</p>
        <p class="text-xl font-extrabold text-accent"><%= money(order.total) %></p>
      </div>
    </div>
    <p class="text-xs text-slate-500 mt-4">Player: <code class="text-slate-300"><%= order.mc_username %></code> · for <%= order.contact %></p>
  <% } %>
</div>

<%- include('partials/footer') %>