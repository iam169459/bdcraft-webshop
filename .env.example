# Neon Postgres connection string (from https://neon.tech)
# Example: postgres://user:password@ep-long-name-1234.us-east-2.aws.neon.tech/bdcraft?sslmode=require
DATABASE_URL=postgres://USER:PASSWORD@HOST/bdcraft?sslmode=require

# Port Render assigns automatically; locally it defaults to 3000
PORT=3000

# Used to sign session + cart cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Public server branding
SHOP_NAME=BDCraft
MC_IP=play.bdcraft.example
MC_VERSION=1.20.4
DISCORD_URL=https://discord.gg/your-invite

# Payment
CURRENCY=BDT
# In-game coin rate: how many coins 1 BDT buys. Used to auto-price coin
# deposits (e.g. a 20 tk pack = 20 * COIN_RATE coins).
COIN_RATE=10
BKASH_NUMBER=01XXXXXXX
BKASH_NAME=BDCraft Shop
ADMIN_NOTES=Send the exact amount and enter your bKash TrxID below.

# Admin login (env-based). Change on deploy!
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-strong-password
